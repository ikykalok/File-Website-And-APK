          <p class="caption" style="color: var(--muted)">Lyrics</p>
        </div>
        <div class="phone-mockup-wrapper">
          <img src="./assets/Screenshot/library.png" alt="Library" class="phone-mockup">
          <p class="caption" style="color: var(--muted)">Library</p>
        </div>
      </div>
    </div>
  </section>



  <section class="features container">
    <div class="features-header">
      <p class="caption-uppercase" style="color: var(--muted); margin-bottom: var(--space-sm);">WHY ECHO</p>
      <h2 class="display-md" style="color: var(--ink); margin-bottom: var(--space-sm);">Everything you need, nothing you don't</h2>
      <p class="body-md" style="color: var(--muted); max-width: 540px; margin: 0 auto;">Eight reasons people choose Echo over every other music player.</p>
    </div>
    <div class="features-grid">
      <div class="feature-card feature-card-1 col-span-2 flex-row">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242"/><path d="M12 12v9"/><path d="m8 17 4 4 4-4"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Offline Playback</h3>
          <p class="body-sm feature-body">Download your music and listen anywhere - no signal needed.</p>
        </div>
      </div>
      <div class="feature-card feature-card-2">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 8-9.04 9.06a2.82 2.82 0 1 0 3.98 3.98L16 12"/><circle cx="17" cy="7" r="5"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Synced Lyrics</h3>
          <p class="body-sm feature-body">Real-time lyrics that scroll along as the song plays. Never miss a word.</p>
        </div>
      </div>
      <div class="feature-card feature-card-3">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Zero Ads, Forever</h3>
          <p class="body-sm feature-body">No banners. No pre-rolls. No interruptions. Music the way it should be.</p>
        </div>
      </div>
      <div class="feature-card feature-card-4">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15V6"/><path d="M18.5 18a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z"/><path d="M12 12H3"/><path d="M16 6H3"/><path d="M12 18H3"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Smart Queue</h3>
          <p class="body-sm feature-body">Echo learns your listening habits and builds a queue you'll actually love.</p>
        </div>
      </div>
      <div class="feature-card feature-card-5">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 16 4-4-4-4"/><path d="m6 8-4 4 4 4"/><path d="m14.5 4-5 16"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Open Source</h3>
          <p class="body-sm feature-body">Every line of code is public. Fork it, audit it, improve it - it's yours.</p>
        </div>
      </div>

      <div class="feature-card feature-card-9 col-span-2 flex-row">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Listen Together</h3>
          <p class="body-sm feature-body">Sync music in real time with your friends, similar to Spotify Jam.</p>
        </div>
      </div>

      <div class="feature-card feature-card-13">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="22"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Podcast Support</h3>
          <p class="body-sm feature-body">Listen to your favorite podcasts alongside your music library.</p>
        </div>
      </div>
      <div class="feature-card feature-card-14 col-span-3 flex-row">
        <svg class="feature-icon-svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="M18.7 8l-5.1 5.2-2.8-2.7L7 14.3"/></svg>
        <div class="feature-content">
          <h3 class="title-md">Data Saver Mode</h3>
          <p class="body-sm feature-body">Automatically reduces data usage during playback for limited connections.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="faq-header">
      <p class="caption-uppercase" style="color: var(--muted); margin-bottom: var(--space-sm);">QUESTIONS</p>
      <h2 class="display-md" style="color: var(--ink);">Straight answers</h2>
    </div>
    <div class="faq-list">
      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">Is Echo Music really free?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">Yes, completely. Echo has no paid tiers, no ads, and no subscription. It's open-source software supported by the community.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">Where do I download Echo?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">Echo is distributed through GitHub Releases. Tap the Download button above to go directly to the latest APK.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">Does Echo need an account?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">No account, no sign-up, no tracking. Open the app and play.</p>
        </div>
      </div>

      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">What Android version do I need?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">Echo runs on Android 6.0 (Marshmallow) and above.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">Can I contribute to Echo?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">Absolutely. Head to github.com/EchoMusicApp/Echo-Music to open issues, submit PRs, or suggest features. All contributors are welcome.</p>
        </div>
      </div>
      <div class="faq-item">
        <div class="faq-question">
          <h3 class="title-sm">Where does the music come from?</h3>
          <span class="faq-icon">+</span>
        </div>
        <div class="faq-answer">
          <p class="body-md">Echo Music is a third-party YouTube Music client. It provides a customized app experience, but Echo Music itself does not host, own, or hold any of the songs.</p>
        </div>
      </div>

    </div>
  </section>



  <footer>
    <div class="container">
      <div class="footer-grid">
        <div class="footer-col-left">
          <div class="footer-logo display-font">
             <img src="./assets/Echo.gif" alt="">
             Echo Music
          </div>
          <div class="footer-disclaimer caption" style="margin-top: 16px; color: var(--muted); max-width: 280px; line-height: 1.4;">
            Echo Music is a third-party YouTube Music client. Echo Music does not host or hold any of the audio content.
          </div>
        </div>
        <div class="footer-col-right">

          <div class="footer-column">
            <div class="footer-column-title display-font">Links</div>
            <a href="privacy.html" class="footer-link">Privacy Policy</a>
            <a href="terms.html" class="footer-link">Terms & Conditions</a>
            <a href="https://www.virustotal.com/gui/file/c3c56f68149f8580b895c42cd8355973421c10e38288620d7317590704ef85ff/detection" class="footer-link" target="_blank" rel="noopener noreferrer">VirusTotal Scan</a>
          </div>


        </div>
      </div>
    </div>
  </footer>


  <div class="support-fab" id="support-fab">

    <a href="./donate.html" target="_blank" rel="noopener noreferrer" style="text-decoration: none; display: flex; flex-direction: column; align-items: flex-end; gap: 16px; pointer-events: none;">
      <div class="support-msg-bubble" style="position: relative; margin-top: 85px;">
        <img src="./assets/cat.gif" alt="Cat" style="width: 90px; height: auto; position: absolute; top: -80px; left: 50%; transform: translateX(-50%); z-index: 1;">
        <span style="position: relative; z-index: 2;"><span id="typewriter-text"></span><span class="cursor">|</span></span>
      </div>
      <div class="support-btn" style="pointer-events: auto;">
        <img src="https://github.com/iad1tya.png" alt="Aditya" class="support-avatar">
      </div>
    </a>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>
  <script>
    window.addEventListener('load', () => {
      const today = new Date();
      const month = today.getMonth();
      const date = today.getDate();

      const showBirthdayEffect = (message) => {
        const bgOverlay = document.createElement('div');
        Object.assign(bgOverlay.style, {
          position: 'fixed',
          top: '0',
          left: '0',
          width: '100vw',
          height: '100vh',
          backgroundColor: '#ffffff',
          zIndex: '9997',
          pointerEvents: 'none',
          transition: 'opacity 1s ease-out',
          opacity: '1'
        });
        document.body.appendChild(bgOverlay);

        const annivText = document.createElement('div');
        annivText.innerText = message;
        Object.assign(annivText.style, {
          position: 'fixed',
          top: '50%',
          left: '50%',
          transform: 'translate(-50%, -50%)',
          fontSize: 'clamp(28px, 6vw, 56px)',
          fontFamily: "'Unbounded', sans-serif",
          fontWeight: '700',
          color: 'var(--ink)',
          textAlign: 'center',
          zIndex: '9999',
          pointerEvents: 'none',
          transition: 'opacity 1s ease-out, transform 1s ease-out',
          opacity: '0',
          textShadow: '0 4px 32px var(--canvas), 0 0 16px var(--canvas), 0 0 8px var(--canvas)'
        });
        document.body.appendChild(annivText);

        setTimeout(() => {
          annivText.style.opacity = '1';
          annivText.style.transform = 'translate(-50%, -60%)';
        }, 100);

        const duration = 3 * 1000;
        const end = Date.now() + duration;
        const colors = ['#b8a4ed', '#ff4d8b', '#a7c7e7', '#ffb084', '#e8b94a', '#a4d4c5'];

        (function frame() {
          confetti({
            particleCount: 5,
            angle: 60,
            spread: 55,
            origin: { x: 0 },
            colors: colors,
            zIndex: 9998
          });
          confetti({
            particleCount: 5,
            angle: 120,
            spread: 55,
            origin: { x: 1 },
            colors: colors,
            zIndex: 9998
          });

          if (Date.now() < end) {
            requestAnimationFrame(frame);
          } else {
            annivText.style.opacity = '0';
            annivText.style.transform = 'translate(-50%, -70%)';
            bgOverlay.style.opacity = '0';
            setTimeout(() => {
              annivText.remove();
              bgOverlay.remove();
            }, 1000);
          }
        }());
      };

      if (month === 8 && date === 21) {
        showBirthdayEffect("Today is Echo Music's Birthday! 🎉");
      } else if (month === 9 && date === 14) {
        showBirthdayEffect("Today is the Developer's Birthday! 🎉");
      }
    });

    const navbar = document.getElementById('navbar');
    window.addEventListener('scroll', () => {
      const currentScrollY = window.scrollY;
      if (currentScrollY > 150) {
        navbar.classList.add('visible');
      } else {
        navbar.classList.remove('visible');
      }

      const fabBubble = document.querySelector('.support-msg-bubble');
      const supportFab = document.getElementById('support-fab');

      const scrollPosition = window.scrollY + window.innerHeight;
      const bodyHeight = document.body.offsetHeight;
      const footer = document.querySelector('footer');
      const footerHeight = footer ? footer.offsetHeight : 0;
      const isNearBottom = scrollPosition > (bodyHeight - footerHeight + 20);

      if (supportFab) {
        supportFab.style.opacity = isNearBottom ? '0' : '1';
        const supportBtn = document.querySelector('.support-btn');
        if (supportBtn) supportBtn.style.pointerEvents = isNearBottom ? 'none' : 'auto';
      }

      if (currentScrollY > 50 && !isNearBottom) {
        if (fabBubble) fabBubble.classList.add('show');
        if (typeof startTypeWriter === 'function') startTypeWriter();
      } else {
        if (fabBubble) fabBubble.classList.remove('show');
      }
    }, {passive: true});



    function animateValue(obj, start, end, duration, prefix = "", suffix = "") {
      let startTimestamp = null;
      const step = (timestamp) => {
        if (!startTimestamp) startTimestamp = timestamp;
        const progress = Math.min((timestamp - startTimestamp) / duration, 1);
        const easeProgress = 1 - Math.pow(1 - progress, 4);
        const current = Math.floor(easeProgress * (end - start) + start);
        if (obj) obj.innerHTML = `${prefix}${current.toLocaleString()}${suffix}`;
        if (progress < 1) {
          window.requestAnimationFrame(step);
        } else {
          if (obj) obj.innerHTML = `${prefix}${end.toLocaleString()}${suffix}`;
        }
      };
      window.requestAnimationFrame(step);
    }

    async function fetchLiveStats() {
      try {
        const repoRes = await fetch('https://api.github.com/repos/EchoMusicApp/Echo-Music');
        if (repoRes.ok) {
          const repoData = await repoRes.json();
          const starsEl = document.getElementById('stat-stars');
          if(starsEl) animateValue(starsEl, 0, repoData.stargazers_count, 2000, "⭐ ", " GitHub Stars");
        }

        const relsRes = await fetch('https://api.github.com/repos/EchoMusicApp/Echo-Music/releases?per_page=100');
        if (relsRes.ok) {
          const relsData = await relsRes.json();
          let dls = 0;
          let apkUrl = "";

          relsData.forEach(rel => {
            rel.assets.forEach(a => {
              dls += a.download_count;
            });
          });

          const latestStable = relsData.find(r => !r.prerelease) || relsData[0];
          if (latestStable) {
            apkUrl = latestStable.html_url;
            latestStable.assets.forEach(a => {
              if (a.name.endsWith('.apk')) apkUrl = a.browser_download_url;
            });
          }

          if (dls > 0) {
            const dlEl = document.getElementById('stat-downloads');
            if(dlEl) animateValue(dlEl, 0, dls, 2000, "📦 ", "+ Downloads");
          }

          document.querySelectorAll('.btn-download').forEach(btn => {
            if(apkUrl) btn.href = apkUrl;
          });
        }
      } catch (e) {
        console.warn("Could not fetch live stats", e);
      }
    }
    fetchLiveStats();

    function createRipple(event) {
      const button = event.currentTarget;
      const circle = document.createElement("span");
      const diameter = Math.max(button.clientWidth, button.clientHeight);
      const radius = diameter / 2;

      let x, y;
      if (event.touches && event.touches.length > 0) {
        x = event.touches[0].clientX - button.getBoundingClientRect().left;
        y = event.touches[0].clientY - button.getBoundingClientRect().top;
      } else {
        x = event.clientX - button.getBoundingClientRect().left;
        y = event.clientY - button.getBoundingClientRect().top;
      }

      circle.style.width = circle.style.height = `${diameter}px`;
      circle.style.left = `${x - radius}px`;
      circle.style.top = `${y - radius}px`;
      circle.classList.add("ripple-span");

      const existingRipple = button.querySelector('.ripple-span');
      if (existingRipple) {
        existingRipple.remove();
      }

      button.appendChild(circle);
      setTimeout(() => circle.remove(), 600);
    }

    const buttons = document.querySelectorAll('.btn.ripple');
    buttons.forEach(btn => {
      btn.addEventListener('mousedown', createRipple);
      btn.addEventListener('touchstart', createRipple, {passive: true});
    });

    const faqItems = document.querySelectorAll('.faq-item');
    faqItems.forEach(item => {
      const question = item.querySelector('.faq-question');
      const answer = item.querySelector('.faq-answer');
      const icon = item.querySelector('.faq-icon');

      question.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');

        faqItems.forEach(otherItem => {
          if (otherItem !== item) {
            otherItem.classList.remove('open');
            otherItem.querySelector('.faq-icon').textContent = '+';
            otherItem.querySelector('.faq-answer').style.maxHeight = null;
          }
        });

        if (isOpen) {
          item.classList.remove('open');
          icon.textContent = '+';
          answer.style.maxHeight = null;
        } else {
          item.classList.add('open');
          icon.textContent = '−';
          answer.style.maxHeight = answer.scrollHeight + 36 + "px";
        }
      });
    });

    const observerOptions = {
      root: null,
      rootMargin: '0px 0px -50px 0px',
      threshold: 0.1
    };

    const featureObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    const featureCards = document.querySelectorAll('.feature-card');
    featureCards.forEach((card, index) => {
      card.style.transitionDelay = `${index * 80}ms`;
      featureObserver.observe(card);
    });

    const faqObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    faqItems.forEach((item, index) => {
      item.style.transitionDelay = `${index * 60}ms`;
      faqObserver.observe(item);
    });

    const typeText = document.getElementById('typewriter-text');
    const msg = "Hi! If you love Echo Music, consider supporting my work! ☕";
    let typeIndex = 0;
    let hasTyped = false;

    function typeWriter() {
      if (typeIndex < msg.length) {
        typeText.innerHTML += msg.charAt(typeIndex);
        typeIndex++;
        setTimeout(typeWriter, 40);
      } else {
        setTimeout(() => {
          const cursor = document.querySelector('.cursor');
          if (cursor) cursor.style.display = 'none';
        }, 2000);
      }
    }

    function startTypeWriter() {
      if (!hasTyped) {
        hasTyped = true;
        setTimeout(typeWriter, 300);
      }
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('active');
        }
      });
    }, { threshold: 0.1 });

    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  </script>
  <script>
    // Animated favicon logic
    (function() {
      const favicon = document.querySelector('link[rel="icon"]');
      if (!favicon) return;
      const totalFrames = 63;
      let currentFrame = 0;
      setInterval(() => {
        currentFrame = (currentFrame + 1) % totalFrames;
        favicon.href = `./assets/favicon-frames/frame_${currentFrame}.png`;
      }, 100);
    })();
  </script>
