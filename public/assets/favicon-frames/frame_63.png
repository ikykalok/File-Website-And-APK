    Site Contains the ads to cover up the costs
  <script>
    setTimeout(() => {
      const notice = document.getElementById('site-notice');
      if (notice) {
        notice.style.transform = 'translateY(-100%)';
        setTimeout(() => notice.remove(), 500);
      }
    }, 5000);

    // Countdown logic
    (function() {
      let timeLeft = 30;
      const timerSpans = document.querySelectorAll('.countdown-timer');
      const timerMsgSpans = document.querySelectorAll('.countdown-timer-msg');
      const countdownBtns = document.querySelectorAll('.countdown-btn');
      const actualDownloadBtns = document.querySelectorAll('.actual-download-btn');
      const countdownMsgs = document.querySelectorAll('.countdown-msg');

      const interval = setInterval(() => {
        timeLeft--;
        timerSpans.forEach(span => span.textContent = timeLeft);
        timerMsgSpans.forEach(span => span.textContent = timeLeft);

        if (timeLeft <= 0) {
          clearInterval(interval);
          countdownBtns.forEach(btn => btn.style.display = 'none');
          actualDownloadBtns.forEach(btn => btn.style.display = 'inline-flex');
          countdownMsgs.forEach(msg => msg.style.display = 'none');
          if (actualDownloadBtns.length > 0) {
            window.location.href = actualDownloadBtns[0].href;
          }
        }
      }, 1000);
    })();
  </script>
